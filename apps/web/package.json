{
  "name": "@lydie/web",
  "version": "2.0.0-alpha.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    "./try": "./src/try.tsx",
    "./styles.css": "./src/index.css",
    "./vite": "./vite.shared.ts"
  },
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "test": "bun test --pass-with-no-tests",
    "typecheck": "bun check",
    "test:e2e": "bun run build:e2e && bun test --timeout 120000 ./e2e/flows.e2e.ts",
    "test:perf": "bun run build:e2e && bun test --timeout 900000 ./e2e/perf.e2e.ts",
    "test:e2e:databases": "VITE_LYDIE_SEED=1 vite build --configLoader runner --outDir .e2e/databases --emptyOutDir && bun test --timeout 900000 ./e2e/databases.e2e.ts ./e2e/databases-perf.e2e.ts",
    "test:e2e:threads": "vite build --configLoader runner --outDir .e2e/threads --emptyOutDir && bun test --timeout 120000 ./e2e/threads.e2e.ts",
    "test:e2e:threads:hosted": "VITE_LYDIE_API_URL=/__core vite build --configLoader runner --outDir .e2e/settings --emptyOutDir && bun test --timeout 240000 ./e2e/threads-hosted.e2e.ts",
    "test:e2e:links": "vite build --configLoader runner --outDir .e2e/links --emptyOutDir && bun test --timeout 120000 ./e2e/links-features.e2e.ts",
    "test:e2e:settings": "VITE_LYDIE_API_URL=/__core vite build --configLoader runner --outDir .e2e/settings --emptyOutDir && bun test --timeout 240000 ./e2e/settings-team.e2e.ts ./e2e/hosted.e2e.ts",
    "build:e2e": "VITE_LYDIE_SEED=1 vite build --configLoader runner --outDir .e2e/main --emptyOutDir",
    "build:e2e:desktop": "vite build --configLoader runner --outDir .e2e/desktop --emptyOutDir"
  },
  "dependencies": {
    "@lydie/app": "workspace:*",
    "@lydie/bridge-fs": "workspace:*",
    "@lydie/contract": "workspace:*",
    "@lydie/editor": "workspace:*",
    "@lydie/markdown": "workspace:*",
    "@lydie/platform": "workspace:*",
    "@lydie/plugin-account": "workspace:*",
    "@lydie/plugin-api": "workspace:*",
    "@lydie/plugin-backlinks": "workspace:*",
    "@lydie/plugin-changelog": "workspace:*",
    "@lydie/plugin-databases": "workspace:*",
    "@lydie/plugin-document-tree": "workspace:*",
    "@lydie/plugin-editor-view": "workspace:*",
    "@lydie/plugin-home": "workspace:*",
    "@lydie/plugin-links": "workspace:*",
    "@lydie/plugin-mdx-components": "workspace:*",
    "@lydie/plugin-mentions": "workspace:*",
    "@lydie/plugin-mermaid": "workspace:*",
    "@lydie/plugin-outline": "workspace:*",
    "@lydie/plugin-page-decor": "workspace:*",
    "@lydie/plugin-properties": "workspace:*",
    "@lydie/plugin-publishing": "workspace:*",
    "@lydie/plugin-quick-capture": "workspace:*",
    "@lydie/plugin-quick-switcher": "workspace:*",
    "@lydie/plugin-search": "workspace:*",
    "@lydie/plugin-settings": "workspace:*",
    "@lydie/plugin-sharing": "workspace:*",
    "@lydie/plugin-slash-menu": "workspace:*",
    "@lydie/plugin-team": "workspace:*",
    "@lydie/plugin-threads": "workspace:*",
    "@lydie/plugin-trash": "workspace:*",
    "@lydie/plugin-versions": "workspace:*",
    "@lydie/runtime": "workspace:*",
    "@lydie/sdk": "workspace:*",
    "@lydie/store": "workspace:*",
    "@lydie/sync": "workspace:*",
    "@lydie/ui": "workspace:*",
    "@tiptap/y-tiptap": "^3.3.0",
    "react": "catalog:",
    "react-aria-components": "catalog:",
    "react-dom": "catalog:",
    "yjs": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@rolldown/plugin-babel": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "playwright": "^1.65.0",
    "tailwindcss": "catalog:",
    "vite": "catalog:"
  }
}
