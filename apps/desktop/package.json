{
  "name": "@lydie/desktop",
  "version": "2.0.0-alpha.1",
  "private": true,
  "description": "Lydie desktop app",
  "license": "AGPL-3.0-only",
  "author": "Lydie",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:diagnostics": "bun scripts/dev.ts --diagnostics",
    "build": "bun --filter=@lydie/web run build && bun run build:native && electron-vite build",
    "build:shell": "bun run build:native && electron-vite build",
    "package": "bun run build && electron-builder --config electron-builder.config.ts",
    "package:dir": "bun run build && electron-builder --config electron-builder.config.ts --dir",
    "start": "electron .",
    "test": "bun test ./src",
    "test:e2e": "bun --filter=@lydie/web run build:e2e:desktop && bun run build:native && electron-vite build && bun test --timeout 60000 ./e2e/*.e2e.ts",
    "measure": "bun scripts/measure.ts",
    "typecheck": "bun check",
    "dist:mac": "bun run build && electron-builder --config electron-builder.config.ts --mac dir --arm64",
    "build:native": "bun scripts/build-native.ts"
  },
  "dependencies": {
    "@parcel/watcher": "2.6.0",
    "@powersync/node": "1.3.1",
    "better-sqlite3": "13.1.1",
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@lydie/app": "workspace:*",
    "@lydie/bridge-fs": "workspace:*",
    "@lydie/contract": "workspace:*",
    "@lydie/mcp-local": "workspace:*",
    "@lydie/platform": "workspace:*",
    "@lydie/runtime": "workspace:*",
    "@lydie/store": "workspace:*",
    "@lydie/sync": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@rolldown/plugin-babel": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "node-api-headers": "1.9.0",
    "playwright-core": "1.65.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:",
    "zod": "catalog:"
  },
  "productName": "Lydie"
}
