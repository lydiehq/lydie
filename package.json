{
  "name": "lydie",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*",
      "plugins/*"
    ],
    "catalog": {
      "@babel/core": "^8.1.2",
      "@rolldown/plugin-babel": "^0.3.1",
      "@tailwindcss/vite": "^4.3.5",
      "@testing-library/react": "^16.3.3",
      "@tiptap/core": "^3.33.1",
      "@tiptap/pm": "^3.33.1",
      "@tiptap/react": "^3.33.1",
      "@tiptap/starter-kit": "^3.33.1",
      "@types/bun": "^1.4.4",
      "@types/node": "^26.6.6",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "@vitejs/plugin-react": "^6.3.0",
      "babel-plugin-react-compiler": "^1.0.0",
      "drizzle-orm": "^0.45.4",
      "hono": "^4.13.18",
      "motion": "^14.14.0",
      "oxfmt": "^0.78.0",
      "oxlint": "^1.93.0",
      "oxlint-tsgolint": "^7.0.2007",
      "react": "^19.3.1",
      "react-aria": "^3.53.1",
      "react-aria-components": "^1.22.1",
      "react-stately": "^3.51.0",
      "react-dom": "^19.3.1",
      "tailwindcss": "^4.3.5",
      "typescript": "^7.0.2",
      "vite": "^8.3.8",
      "yjs": "^13.6.33",
      "zod": "^4.6.7"
    }
  },
  "type": "module",
  "scripts": {
    "dev:web": "bun --filter=@lydie/web dev",
    "dev:desktop": "bun --filter=@lydie/desktop dev",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "typecheck": "bun check --no-script -p tsconfig.json && bun --filter='*' typecheck",
    "test": "bun test ./scripts && bun run --filter='*' test",
    "check:boundaries": "bun scripts/check-boundaries.ts",
    "check:generated": "bun --filter=@lydie/contract --filter=@lydie/sdk run generate:check",
    "seed": "bun scripts/seed/index.ts",
    "seed:demo": "bun scripts/seed/demo-folder.ts",
    "bench": "bun test ./scripts/bench/store.bench.ts --timeout 600000",
    "bench:markdown": "bun --filter=@lydie/markdown run bench",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test && bun run check:boundaries && bun run check:generated"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  }
}
